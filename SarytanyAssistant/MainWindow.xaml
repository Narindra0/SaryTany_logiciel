<Window x:Class="SarytanyAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant Sarytany - Neo-Carbon v3.0"
        Width="1100" Height="720" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <!-- ===== BANDEAU DE TITRE (52px, sombre) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource TitleBar}" Height="52">
            <Grid Margin="20,0,16,0">
                <TextBlock Text="Assistant Sarytany  ·  Neo-Carbon v3.0"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="LblLicense" Text="Licence : -"
                           Foreground="#6EE7B7" FontSize="11.5"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ===== PIED DE PAGE (32px) ===== -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FB" Height="32"
                BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="LblViewName" Text="Vue : Configuration PC"
                           FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblStatus" Text="Pret" FontSize="11.5"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ===== BARRE LATERALE (230px) ===== -->
        <Border DockPanel.Dock="Left" Background="{StaticResource Sidebar}" Width="230">
            <StackPanel Margin="12,16,12,0">
                <RadioButton x:Name="NavPc"       Style="{StaticResource NavItem}" Content="Configuration PC"     IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSuite"    Style="{StaticResource NavItem}" Content="Installation Suite"   Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTerra"    Style="{StaticResource NavItem}" Content="Installation Terra"   Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSintegra" Style="{StaticResource NavItem}" Content="SintegraLidar"        Checked="Nav_Checked"/>
                <RadioButton x:Name="NavBentley"  Style="{StaticResource NavItem}" Content="Deploiement Bentley"  Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU ===== -->
        <Grid x:Name="ContentHost" Margin="0"/>
    </DockPanel>
</Window>
