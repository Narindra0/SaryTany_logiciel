<Window x:Class="SarytanyAssistant.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licence - Assistant Sarytany Neo-Carbon"
        Width="460" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CardBg}" CornerRadius="14" BorderBrush="{StaticResource Separator}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bandeau sombre, comme la fenetre principale -->
            <Border Grid.Row="0" Background="{StaticResource TitleBar}" CornerRadius="14,14,0,0">
                <TextBlock Text="Assistant Sarytany  ·  Activation"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="20,0"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="32,26,32,24">
                <TextBlock Text="Licence requise" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="Saisissez le code d'activation fourni par votre administrateur."
                           FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <TextBlock Text="Code d'activation" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="TxtCode" Height="32" FontSize="14" Padding="6,4"
                             BorderBrush="{StaticResource Separator}"
                             KeyDown="TxtCode_KeyDown"/>
                <TextBlock x:Name="LblError" Text="" Foreground="{StaticResource Red}" FontSize="12"
                           Margin="2,8,0,0" Visibility="Collapsed"/>
                <Button Content="Activer" Style="{StaticResource PrimaryButton}" Height="38"
                        Margin="0,18,0,0" Click="Activate_Click"/>
                <TextBlock Text="Sans validation, l'application se ferme."
                           FontSize="11" Foreground="{StaticResource Slate}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
