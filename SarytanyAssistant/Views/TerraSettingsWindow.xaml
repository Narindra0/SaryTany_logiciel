<Window x:Class="SarytanyAssistant.Views.TerraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reglages Terra" Width="584" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Bg}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TerraRoot -->
            <RowDefinition Height="Auto"/> <!-- SetupVersion -->
            <RowDefinition Height="Auto"/> <!-- TscanDir -->
            <RowDefinition Height="Auto"/> <!-- PowerDraftExe -->
            <RowDefinition Height="Auto"/> <!-- ComputerId -->
            <RowDefinition Height="Auto"/> <!-- Silent -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- boutons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Dossier principal Terra (contient eng\)" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource TinyButton}"
                        Width="100" Margin="8,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="TxtTerraRoot" Style="{StaticResource Field}"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="Version a installer" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CmbVersion" Style="{StaticResource FieldCombo}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Dossier cible TerraScan" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtTscanDir" Style="{StaticResource Field}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="PowerDraft.exe" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtPowerDraft" Style="{StaticResource Field}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Computer ID (Tools &gt; About)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtComputerId" Style="{StaticResource Field}" Margin="0,4,0,0"/>
        </StackPanel>

        <CheckBox x:Name="ChkSilent" Grid.Row="5" Margin="0,16,0,0" Style="{StaticResource FieldCheck}"
                  Content="Installation silencieuse (/quiet - la selection de version est ignoree)"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Width="250" Height="38" Click="Ok_Click"/>
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Width="120" Height="38"
                    Margin="18,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
